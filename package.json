{
  "name": "multifill",
  "version": "0.1.1",
  "description": "Fill every language field of a form from one click. Chrome extension for multilingual admin panels and CMS forms.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@playwright/test": "^1.65.0",
    "@types/chrome": "^0.3.7",
    "@types/webextension-polyfill": "^0.12.6",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  }
}
